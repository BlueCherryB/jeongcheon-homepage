{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeongcheon-homepage",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jeongcheon-homepage"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "jeongcheon-homepage-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-opennext-cache-queue",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "jeongcheon-homepage-tags",
      "database_id": "f90e0b53-cc92-4c17-979c-6c0e5b58d465"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}